# EduPredict Environment Configuration

# Django Settings
DJANGO_SECRET_KEY=django-insecure-edupredict-key-change-in-production-123456789
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# MongoDB Configuration
# Replace with your MongoDB connection string (Atlas URI or local URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=edupredict_db
